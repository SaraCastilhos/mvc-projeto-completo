<!DOCTYPE html>

<html lang="pt-br">

<head>
    
    <meta charset="UTF-8">
    <title>Produtos</title>

    <link rel="stylesheet" href="/CSS/global.css">
    <!-- CSS global usado em várias páginas -->

    <link rel="stylesheet" href="/CSS/produtos.css">
    <!-- CSS específico da página de produtos -->
</head>

<body>
    <!-- Corpo visível da página -->

    <div class="container">
        <!-- Container principal para organizar todo o conteúdo -->

        <nav>
            <!-- Menu de navegação entre páginas -->
            
            <a href="/">Home</a>
            <a href="/sobre">Sobre</a>
            <a href="/contato">Contato</a>
            <a href="/produtos">Produtos</a>
        </nav>

        <h1>Gerenciamento de Produtos</h1>
        <!-- Título principal da página -->

        <% if (mensagem) { %>
            <!-- Verifica se existe mensagem enviada pelo controller -->

            <div class="mensagem">
                <%= mensagem %>
                <!-- Mostra a mensagem na tela -->
            </div>
        <% } %>

        <div class="topo-acoes">
            <!-- Área superior com formulário de adicionar e buscar -->

            <!-- ADICIONAR -->
            <form action="/produtos" method="POST">
                <!-- Formulário que envia dados para cadastrar produto -->

                <input type="text" name="nome" placeholder="Nome do produto" required>
                <!-- Campo do nome -->

                <input type="number" step="0.01" name="preco" placeholder="Preço" required>
                <!-- Campo do preço -->

                <button class="btn-add">Adicionar</button>
                <!-- Botão para cadastrar -->
            </form>

            <!-- BUSCAR -->
            <form action="/produtos" method="GET">
                <!-- Formulário GET para pesquisa de produtos -->

                <input class="campo-busca" type="text" name="busca" value="<%= busca %>"
                    placeholder="Buscar produto...">
                <!-- Campo que mantém o valor digitado na busca -->

                <button class="btn-edit">Buscar</button>
                <!-- Botão de pesquisa -->
            </form>

        </div>

        <table class="tabela-produtos">
            <!-- Tabela principal de listagem -->

            <thead>
                <!-- Cabeçalho da tabela -->
                <tr>
                    <th>Produto</th>
                    <th>Preço</th>
                    <th style="width: 220px;">Ações</th>
                </tr>
            </thead>

            <tbody>
                <!-- Corpo da tabela -->

                <% if (produtos.length===0) { %>
                    <!-- Se não houver produtos, mostra mensagem -->

                    <tr>
                        <td colspan="3" class="vazio">
                            Nenhum produto encontrado.
                        </td>
                    </tr>
                <% } %>

                <% produtos.forEach((produto, index)=> { %>
                    <!-- Percorre todos os produtos do array -->

                    <tr>

                        <% if (editIndex==index) { %>
                            <!-- Verifica se a linha atual está em modo edição -->

                            <form action="/produtos/salvar/<%= index %>" method="POST">
                                <!-- Formulário para salvar edição -->

                                <td>
                                    <input type="text" name="nome" value="<%= produto.nome %>" required>
                                    <!-- Campo editável do nome -->
                                </td>

                                <td>
                                    <input type="number" step="0.01" name="preco"
                                        value="<%= produto.preco %>" required>
                                    <!-- Campo editável do preço -->
                                </td>

                                <td class="acoes">
                                    <button class="btn-save">Salvar</button>
                                    <!-- Botão para salvar edição -->
                            </form>

                            <a href="/produtos">
                                <!-- Cancela edição e volta para lista -->
                                <button type="button">Cancelar</button>
                            </a>
                            </td>

                        <% } else { %>
                            <!-- Exibição normal da linha -->

                            <td>
                                <strong><%= produto.nome %></strong>
                                <!-- Nome do produto -->
                            </td>

                            <td>
                                R$ <%= Number(produto.preco).toFixed(2) %>
                                <!-- Preço formatado com 2 casas -->
                            </td>

                            <td class="acoes">
                                <!-- Área dos botões -->

                                <a href="/produtos/editar/<%= index %>">
                                    <button class="btn-edit">Editar</button>
                                    <!-- Ativa modo edição -->
                                </a>

                                <form action="/produtos/excluir/<%= index %>" method="POST">
                                    <button class="btn-delete">Excluir</button>
                                    <!-- Remove o produto -->
                                </form>
                            </td>

                        <% } %>

                    </tr>
                <% }) %>
            </tbody>

        </table>

    </div>
</body>

</html>